# Local Development Database Isolation (.env.local)
# Copy this file to .env.local for isolated local development.

PORT=5005
NODE_ENV=development

# Database - Local or Isolated Development Database Instance
# Ensure local development never points to production DB unless specifically intended.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/hikarii_dev?pgbouncer=true"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/hikarii_dev"

# Local Server API & Client Settings
CLIENT_URL=http://localhost:5173
VITE_API_URL=http://localhost:5005/api
