# ==============================================================================
# HIKARII APPLICATION ENVIRONMENT TEMPLATE
# ==============================================================================
# Copy this file to .env or .env.local and populate with your credentials.
# NEVER commit real credentials or secret keys to source control.

# --- SERVER CONFIGURATION ---
PORT=5005
NODE_ENV=development
CLIENT_URL=http://localhost:5173
FRONTEND_URL=http://localhost:5173
VITE_API_URL=http://localhost:5005/api

# --- DATABASE (PRISMA / POSTGRESQL) ---
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/hikarii_dev?schema=public
DIRECT_URL=postgresql://postgres:postgres@localhost:5432/hikarii_dev?schema=public

# --- AUTHENTICATION & SECURITY ---
JWT_SECRET=your_super_secret_jwt_signing_key_min_32_characters
JWT_EXPIRES_IN=7d
ADMIN_EMAIL=admin@hikarii.org
TEST_ADMIN_PASSWORD=your_secure_test_password_here
TEST_USER_PASSWORD=your_secure_test_password_here

# --- AI & GOOGLE GEMINI ---
GEMINI_API_KEY=AIzaSyYourGeminiApiKeyPlaceholder

# --- GOOGLE OAUTH & CALENDAR INTEGRATION ---
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-your_google_client_secret
VITE_GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com

# --- STRIPE BILLING & SUBSCRIPTIONS ---
STRIPE_SECRET_KEY=sk_test_placeholder_key_51ABC...
STRIPE_WEBHOOK_SECRET=whsec_placeholder_webhook_secret...
STRIPE_PRO_PRICE_ID=price_placeholder_monthly_id
STRIPE_PRO_YEARLY_PRICE_ID=price_placeholder_yearly_id
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_placeholder_key_51ABC...
VITE_STRIPE_PRO_PRICE_ID=price_placeholder_monthly_id
VITE_STRIPE_PRO_YEARLY_PRICE_ID=price_placeholder_yearly_id

# --- EMAIL SERVICE (RESEND) ---
RESEND_API_KEY=re_placeholder_resend_api_key
EMAIL_DOMAIN=hikarii.org
STAY_FOCUSED_EMAIL_DOMAIN=notifications.hikarii.org

# --- REDIS / BACKGROUND QUEUE (BULLMQ) ---
REDIS_URL=redis://localhost:6379

# --- ERROR TRACKING & OBSERVABILITY (SENTRY) ---
SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0
VITE_SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0

# --- SUPABASE (STORAGE & ASSETS) ---
SUPABASE_URL=https://your-supabase-project.supabase.co
VITE_SUPABASE_URL=https://your-supabase-project.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.placeholder_anon_key

# --- WHATSAPP NOTIFICATIONS (OPTIONAL) ---
WHATSAPP_PHONE_NUMBER_ID=123456789012345
WHATSAPP_ACCESS_TOKEN=EAAG_placeholder_whatsapp_token

# --- DEPLOYMENT ENVIRONMENT (OPTIONAL) ---
RAILWAY_ENVIRONMENT=development
